# Copy to .env.local (git ignored) and fill in to turn on lesson generation.
# These are read only on the server. Never give them a NEXT_PUBLIC_ prefix.

# Claude API key
ANTHROPIC_API_KEY=
# Claude model ID that writes lessons (see README: Lesson generation)
LESSON_MODEL=
# Optional: turns on POST /api/cron/generate
CRON_SECRET=
# Optional: where passing lessons are saved (default content/generated)
# GENERATED_LESSONS_DIR=
# Optional: set to off to turn off server-side fallback, or generation as a whole
# LESSON_FALLBACKS=off
# LESSON_GENERATION=off
