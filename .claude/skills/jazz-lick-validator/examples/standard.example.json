  "analysis": {
    "summary": "The tune alternates a major ii–V–I in the relative major with a minor ii–V–i in the home key, so the same few shapes cover almost every bar.",
    "sections": [
      {
        "label": "A",
        "text": "Bars 1–4 are ii–V–I–IV in the relative major; bars 5–8 are iiø–V–i in the home minor key."
      },
      {
        "label": "C",
        "text": "Bars 27–28 move down in ii–V-like steps, a chromatic slide that returns to the minor ii–V."
      }
    ],
    "variations": [
      {
        "name": "Altered dominant",
        "chords": [
          {
            "bar": 6,
            "beat": 1,
            "symbol": "D7b9",
            "roman": "V7b9"
          }
        ],
        "text": "Players often play the V of the minor key with a flat 9, which matches the harmonic minor sound."
      },
      {
        "name": "Tonic as m7",
        "chords": [
          {
            "bar": 7,
            "beat": 1,
            "symbol": "Gm7",
            "roman": "i7"
          }
        ],
        "text": "The minor tonic is played as m6 or m7; m6 keeps the major 6th from the melodic minor."
      }
    ]
  },
